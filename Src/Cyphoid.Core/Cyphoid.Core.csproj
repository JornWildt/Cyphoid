<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- NuGet package metadata -->
    <PackageId>Cyphoid</PackageId>
    <Version>0.15.0</Version>
    <Authors>Jørn Wildt</Authors>
    <Description>A parser for the Cypher graph query language. It includes a simple implementation of the query language.</Description>
    <PackageTags>parser cypher query language</PackageTags>
    <RepositoryUrl>https://github.com/JornWildt/Cyphoid</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Title>Cyphoid</Title>
    <Copyright>(C) 2026 - Jørn Wildt</Copyright>
    <PackageProjectUrl>https://github.com/JornWildt/Cyphoid</PackageProjectUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>    
  </PropertyGroup>

  <PropertyGroup>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <PackageReleaseNotes>0.15.0: Added coalesce(), toLower(), toUpper(), trim(), ltrim(), rtrim(), toString(), toInteger(), toFloat(), toBoolean(), string size(), substring(), replace(), left(), right(), abs(), round(), floor(), and ceil(). Functions use .NET semantics, with lazy coalescing, null propagation, argument validation, invariant casing and conversions, UTF-16 string indexing, and .NET midpoint rounding modes.
Added n:label predicates for checking a node's single type, including boolean combinations in WHERE and projected expressions. Label comparisons are ordinal and case-sensitive; null nodes produce null.
Full changelog: https://github.com/JornWildt/Cyphoid/blob/master/CHANGES.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../CHANGES.md" Pack="true" PackagePath="/" />
    <None Include="../../PROCEDURES.md" Pack="true" PackagePath="/" />
    <None Include="../../ERROR_HANDLING.md" Pack="true" PackagePath="/" />
    <None Include="../../MAPS.md" Pack="true" PackagePath="/" />
    <None Include="../../PARAMETERS.md" Pack="true" PackagePath="/" />
    <None Include="../../EXISTS.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  
  <ItemGroup>
    <Folder Include="Antlr\Generated\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="System.Linq.Async" Version="7.0.1" />
  </ItemGroup>

</Project>
