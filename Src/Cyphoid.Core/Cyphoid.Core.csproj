<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- NuGet package metadata -->
    <PackageId>Cyphoid</PackageId>
    <Version>0.12.0</Version>
    <Authors>Jørn Wildt</Authors>
    <Description>A parser for the Cypher graph query language. It includes a simple implementation of the query language.</Description>
    <PackageTags>parser cypher query language</PackageTags>
    <RepositoryUrl>https://github.com/JornWildt/Cyphoid</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Title>Cyphoid</Title>
    <Copyright>(C) 2026 - Jørn Wildt</Copyright>
    <PackageProjectUrl>https://github.com/JornWildt/Cyphoid</PackageProjectUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>    
  </PropertyGroup>

  <PropertyGroup>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <PackageReleaseNotes>0.12.0: Added rand(), id(), labels(), IS NULL / IS NOT NULL, and CONTAINS / STARTS WITH / ENDS WITH. Added ORDER BY and LIMIT for WITH and support for sorting by variables omitted from RETURN. Fixed OPTIONAL MATCH and added row metadata support. Breaking backend API changes: removed generic ID parameters from execution interfaces and added IGraphNode.GetId().
Full changelog: https://github.com/JornWildt/Cyphoid/blob/master/CHANGES.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../CHANGES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  
  <ItemGroup>
    <Folder Include="Antlr\Generated\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="System.Linq.Async" Version="7.0.1" />
  </ItemGroup>

</Project>
