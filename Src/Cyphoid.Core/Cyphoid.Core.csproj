<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- NuGet package metadata -->
    <PackageId>Cyphoid</PackageId>
    <Version>1.1.0</Version>
    <Authors>Jørn Wildt</Authors>
    <Description>A parser for the Cypher graph query language. It includes a simple implementation of the query language.</Description>
    <PackageTags>parser cypher query language</PackageTags>
    <RepositoryUrl>https://github.com/JornWildt/Cyphoid</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Title>Cyphoid</Title>
    <Copyright>(C) 2026 - Jørn Wildt</Copyright>
    <PackageProjectUrl>https://github.com/JornWildt/Cyphoid</PackageProjectUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>    
  </PropertyGroup>

  <PropertyGroup>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <PackageReleaseNotes>1.1.0: Fixed null propagation in comparisons and IN, and three-valued AND/OR/NOT in scalar and asynchronous EXISTS expressions. WHERE accepts only true; use IS NULL for null checks. Host scan and expansion filters must retain unknown candidates for residual evaluation.
Renamed relationship-type parameters and operator members to use relationshipType rather than relationLabel. Documentation describes the backend contracts and query semantics, including SQL candidate filtering requirements.
Full changelog: https://github.com/JornWildt/Cyphoid/blob/master/CHANGES.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../CHANGES.md" Pack="true" PackagePath="/" />
    <None Include="../../PROCEDURES.md" Pack="true" PackagePath="/" />
    <None Include="../../ERROR_HANDLING.md" Pack="true" PackagePath="/" />
    <None Include="../../MAPS.md" Pack="true" PackagePath="/" />
    <None Include="../../PARAMETERS.md" Pack="true" PackagePath="/" />
    <None Include="../../EXISTS.md" Pack="true" PackagePath="/" />
    <None Include="../../BACKEND_GUIDE.md" Pack="true" PackagePath="/" />
    <None Include="../../DATABASE_BACKEND.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  
  <ItemGroup>
    <Folder Include="Antlr\Generated\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="System.Linq.Async" Version="7.0.1" />
  </ItemGroup>

</Project>
